@inject IConfiguration Config
@{
    var path = Context.Request.Path.Value?.TrimEnd('/').ToLowerInvariant() ?? "";
    bool Active(string prefix) => path == prefix || path.StartsWith(prefix + "/");
    string? Cur(bool on) => on ? "page" : null;
    var baseUrl = SiteInfo.BaseUrl(Context);
    var title = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(title) ? $"{SiteInfo.ShortName}｜AI 應用建置・智慧管理平台・Cosaty 資安監控" : $"{title}｜{SiteInfo.ShortName}";
    var description = ViewData["Description"] as string
        ?? "千機科技專注於政府、國防、醫療、學校與金融機構的 AI 應用建置、智慧管理平台與系統開發，並自主研發 Cosaty 資安監控平台。";
    var canonical = baseUrl + (string.IsNullOrEmpty(path) ? "/" : path);
    var gaId = Config["GoogleAnalytics:MeasurementId"];
    var orgJson = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = SiteInfo.Name,
        ["alternateName"] = SiteInfo.EnglishName,
        ["url"] = baseUrl,
        ["logo"] = baseUrl + "/img/apm-logo.png",
        ["telephone"] = SiteInfo.TelHref,
        ["faxNumber"] = "+886277267689",
        ["email"] = SiteInfo.Email,
        ["address"] = new Dictionary<string, string>
        {
            ["@type"] = "PostalAddress",
            ["streetAddress"] = "忠孝東路一段85號12樓之4",
            ["addressLocality"] = "中正區",
            ["addressRegion"] = "台北市",
            ["postalCode"] = SiteInfo.PostalCode,
            ["addressCountry"] = "TW",
        },
    }, new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
}
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SiteInfo.Name" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@(baseUrl)/img/apm-logo.png" />
    <meta property="og:locale" content="zh_TW" />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&amp;family=Noto+Serif+TC:wght@600;700;900&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="application/ld+json">@Html.Raw(orgJson)</script>
    @if (!string.IsNullOrWhiteSpace(gaId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@gaId');
        </script>
    }
</head>
<body>
    <a class="skip-link" href="#main">跳到主要內容</a>

    <div class="gov-bar">
        <div class="container">
            <span>AI 應用建置・智慧管理平台・Cosaty 資安監控平台</span>
            <span>
                <a href="~/contact">聯絡我們</a>
                <a href="~/sitemap">網站導覽</a>
            </span>
        </div>
    </div>

    <header class="site-header">
        <div class="container">
            <a class="brand" href="~/" aria-label="千機科技 首頁">
                <img src="~/img/apm-logo.png" asp-append-version="true" alt="APM 千機科技 logo" width="56" height="56" />
                <span class="brand-text">
                    <b>千機科技</b>
                    <small>APM TECHNOLOGY CO., LTD.</small>
                </span>
            </a>
            <button class="nav-toggle" id="navToggle" type="button" aria-controls="mainNav" aria-expanded="false" aria-label="開啟選單">
                <partial name="_Icon" model='"menu"' />
            </button>
            <nav class="main-nav" id="mainNav" aria-label="主選單">
                <a href="~/project" aria-current="@Cur(Active("/project"))">專案開發</a>
                <a href="~/success" aria-current="@Cur(Active("/success"))">成功案例</a>
                <a href="~/cosaty" aria-current="@Cur(Active("/cosaty"))">Cosaty 資安</a>
                <a href="~/about" aria-current="@Cur(Active("/about"))">公司簡介</a>
                <a href="~/news" aria-current="@Cur(Active("/news"))">最新消息</a>
                <a class="nav-cta" href="~/contact">洽詢專案</a>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="foot-top">
                <div class="foot-brand">
                    <a class="b" href="~/">
                        <span class="lg"><img src="~/img/apm-logo.png" asp-append-version="true" alt="" /></span>
                        <span>@SiteInfo.Name</span>
                    </a>
                    <span>@SiteInfo.EnglishName</span>
                    <span class="addr-zh">@SiteInfo.PostalCode @SiteInfo.Address</span>
                    <span>@SiteInfo.AddressEn</span>
                    <span>電話　<a href="tel:@SiteInfo.TelHref">@SiteInfo.Tel</a>　傳真　@SiteInfo.Fax</span>
                    <span>信箱　<a href="mailto:@SiteInfo.Email">@SiteInfo.Email</a></span>
                </div>
                <nav class="foot-nav" aria-label="頁尾選單">
                    <div>
                        <h3>產品服務</h3>
                        <ul>
                            <li><a href="~/project">專案開發</a></li>
                            <li><a href="~/project#webdesign">網站開發設計</a></li>
                            <li><a href="~/cosaty">Cosaty 主機及網站安全</a></li>
                            <li><a href="~/cosaty/endpoint">Cosaty 端點資安防護</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3>公司</h3>
                        <ul>
                            <li><a href="~/about">公司簡介</a></li>
                            <li><a href="~/success">成功案例</a></li>
                            <li><a href="~/news">最新消息</a></li>
                            <li><a href="~/contact">聯絡我們</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3>資訊</h3>
                        <ul>
                            <li><a href="~/policy">資訊安全政策</a></li>
                            <li><a href="~/sitemap">網站導覽</a></li>
                        </ul>
                    </div>
                </nav>
            </div>
            <div class="foot-bottom">
                <span>&copy; @DateTime.Now.Year @SiteInfo.Name 版權所有</span>
                <span>ISO 27001:2022 / CNS 27001:2023 ・ <a href="~/policy">資訊安全政策宣告</a></span>
            </div>
        </div>
    </footer>

    <button type="button" class="back-top" id="backTop" aria-label="回到頁面頂端"><partial name="_Icon" model='"up"' /></button>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
