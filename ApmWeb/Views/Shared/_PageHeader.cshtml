@{
    var title = ViewData["Title"] as string ?? "";
    var subtitle = ViewData["Subtitle"] as string;
    var eyebrow = ViewData["Eyebrow"] as string;
}
<section class="page-hero">
    <div class="container">
        <nav class="crumbs" aria-label="麵包屑">
            <a href="~/">首頁</a><span aria-hidden="true">/</span>
            <span class="cur">@title</span>
        </nav>
        <div class="page-hero-body">
            <div class="page-hero-title">
                @if (!string.IsNullOrEmpty(eyebrow)) { <span class="eyebrow light">@eyebrow</span> }
                <h1>@title</h1>
            </div>
            @if (!string.IsNullOrEmpty(subtitle)) { <p>@subtitle</p> }
        </div>
    </div>
</section>
