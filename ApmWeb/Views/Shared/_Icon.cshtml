@model string
@{
    var cls = Model.EndsWith("-sm") ? "icon sm" : "icon";
    var name = Model.Replace("-sm", "");
}
<svg class="@cls" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
@switch (name)
{
    case "project":
        <rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="M3 8h18"></path><path d="M8 21h8"></path><path d="M12 18v3"></path>
        break;
    case "shield":
        <path d="M12 3l8 4v5c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V7z"></path><path d="M9 12l2 2 4-4"></path>
        break;
    case "web":
        <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"></path>
        break;
    case "ai":
        <rect x="6" y="6" width="12" height="12" rx="2"></rect><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3"></path><path d="M10 15v-5l2 3 2-3v5"></path>
        break;
    case "lock":
        <rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 018 0v3"></path>
        break;
    case "pdf":
        <path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v4h4"></path><path d="M9 14h6"></path><path d="M9 17h4"></path>
        break;
    case "pin":
        <path d="M12 21s7-6.2 7-11a7 7 0 00-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle>
        break;
    case "phone":
        <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"></path>
        break;
    case "mail":
        <rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>
        break;
    case "user":
        <circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path>
        break;
    case "check":
        <circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.7 2.7L16 9.5"></path>
        break;
    case "menu":
        <path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
        break;
    case "up":
        <path d="M6 14l6-6 6 6"></path>
        break;
    case "doc":
        <path d="M5 4h14v16H5z"></path><path d="M8 9h8"></path><path d="M8 13h8"></path><path d="M8 17h5"></path>
        break;
    case "download":
        <path d="M12 4v11"></path><path d="M7 11l5 5 5-5"></path><path d="M5 20h14"></path>
        break;
}
</svg>
