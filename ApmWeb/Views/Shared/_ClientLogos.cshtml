<div class="logo-carousel" data-carousel>
    <button type="button" class="logo-nav" data-dir="-1" aria-label="上一組合作單位"><partial name="_Icon" model='"left"' /></button>
    <div class="logo-track" tabindex="0" role="region" aria-label="合作單位，可左右捲動">
        @foreach (var c in Clients.All)
        {
            <div class="l@(c.Dark ? " dark" : "")" title="@c.Name">
                <img src="~/img/@c.Logo" alt="@c.Name" loading="lazy" draggable="false" />
            </div>
        }
    </div>
    <button type="button" class="logo-nav" data-dir="1" aria-label="下一組合作單位"><partial name="_Icon" model='"right"' /></button>
</div>
