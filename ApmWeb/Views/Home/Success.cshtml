@model IReadOnlyList<CaseStudy>
@{
    ViewData["Title"] = "成功案例";
    ViewData["Eyebrow"] = "SELECTED WORK";
    ViewData["Subtitle"] = "從主官網 RWD、民意信箱到 Cosaty 資安與 AI，深耕國防、醫療與政府單位的長期履約實績。";
    ViewData["Description"] = "千機科技成功案例：國防部全球資訊網與民意信箱、國防醫學院、三軍總醫院、全民防衛動員署、國防大學，以及 Cosaty 資安平台與 AI 賦能軍民通用資安計畫。";
}
<partial name="_PageHeader" />

<section class="section" id="all-cases">
    <div class="container">
        <partial name="_SectionTitle" model='new SectionHeading("PROJECT RECORD", "專案履約實績", "依案件類型篩選。履約年度以政府機關專案期程為準，持續維運的案件標示至今年。")' />

        <div class="filter" role="group" aria-label="案例分類">
            <button type="button" data-filter="all" aria-pressed="false">全部</button>
            @foreach (var cat in CaseStudies.Categories.Where(c => Model.Any(m => m.Category == c)))
            {
                <button type="button" data-filter="@cat" aria-pressed="@(cat == CaseStudies.Ai ? "true" : "false")">@cat</button>
            }
        </div>

        <div class="case-grid">
            @for (var i = 0; i < Model.Count; i++)
            {
                var c = Model[i];
                <article class="case" data-category="@c.Category" hidden="@(c.Category != CaseStudies.Ai)">
                    <partial name="_CaseCover" model="(c, i)" />
                    <div class="case-body">
                        <h3>@c.Title</h3>
                        <p>@c.Summary</p>
                        <ul class="ticks">
                            @foreach (var s in c.Scope) { <li>@s</li> }
                        </ul>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="logos" style="border-top:0;margin-top:0;padding-top:0">
            <span class="tag">合作單位</span>
            <partial name="_ClientLogos" />
        </div>
    </div>
</section>

<partial name="_CtaBand" />
